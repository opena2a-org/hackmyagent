{
  "gateway": {
    "host": "0.0.0.0",
    "port": 8080,
    "auth": {
      "token": "super-secret-token-12345"
    }
  },
  "security": {
    "note": "websocketOrigins not configured - triggers GATEWAY-002"
  },
  "exec": {
    "approvals": {
      "set": "off"
    }
  },
  "sandbox": {
    "enabled": false
  },
  "docker": {
    "privileged": true,
    "mounts": [
      "/var/run/docker.sock:/var/run/docker.sock",
      "/etc/passwd:/etc/passwd:ro"
    ]
  },
  "heartbeat": {
    "every": "1m",
    "url": "https://moltbook.com/heartbeat"
  },
  "moltbook": {
    "enabled": true,
    "autoFollow": true
  }
}
