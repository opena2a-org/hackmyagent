{
  "name": "hackmyagent",
  "version": "0.32.0",
  "description": "Find it. Break it. Fix it. The hacker's toolkit for AI agents.",
  "bin": {
    "hackmyagent": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./nanomind-core": "./dist/nanomind-core/index.js",
    "./plugins": "./dist/plugins/core.js",
    "./semantic": "./dist/semantic/index.js",
    "./arp": "./dist/arp/index.js",
    "./oasb": "./dist/oasb/harness/arp-wrapper.js",
    "./memory": "./dist/attack/payloads/memory-weaponization.js",
    "./context-window": "./dist/attack/payloads/context-window.js",
    "./supply-chain": "./dist/attack/payloads/supply-chain.js",
    "./shadow": "./dist/attack/payloads/tool-shadow.js",
    "./parser-differential": "./dist/attack/payloads/parser-differential.js",
    "./persistent-agent": "./dist/attack/payloads/persistent-agent.js",
    "./fake-tool": "./dist/attack/payloads/fake-tool.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"const{generateManifest}=require('./dist/nanomind-core/security/integrity-verifier.js');const m=generateManifest(__dirname);if(m)require('fs').writeFileSync('dist/integrity-manifest.json',JSON.stringify(m))\"",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "guard:token-shapes": "tsx scripts/token-shape-guard.ts",
    "release-smoke:corpus": "tsx scripts/release-smoke-corpus.ts",
    "audit:consumer": "node scripts/audit-consumer-resolution.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/ed25519": "^2.3.0",
    "@noble/post-quantum": "^0.2.1",
    "@opena2a/aim-core": "0.1.2",
    "@opena2a/aim-sdk": "1.3.1",
    "@opena2a/check-core": "0.3.0",
    "@opena2a/cli-ui": "0.5.2",
    "@opena2a/contribute": "0.3.0",
    "@opena2a/credential-patterns": "0.1.1",
    "@opena2a/registry-client": "0.2.0",
    "@opena2a/shared": "0.1.2",
    "@opena2a/telemetry": "0.3.0",
    "commander": "^12.0.0",
    "js-yaml": "^4.3.1",
    "onnxruntime-node": "^1.27.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "ip-address": "^10.3.1",
    "fast-uri": "^3.1.5",
    "hono": "^4.12.34",
    "adm-zip": "^0.6.0",
    "@hono/node-server": "^2.0.5",
    "body-parser": "^2.3.0"
  },
  "keywords": [
    "ai",
    "agent",
    "security",
    "mcp",
    "claude",
    "cursor",
    "skills",
    "hardening",
    "scanner",
    "attack",
    "benchmark",
    "runtime-protection"
  ],
  "author": "OpenA2A",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/opena2a-org/hackmyagent.git"
  },
  "homepage": "https://github.com/opena2a-org/hackmyagent#readme",
  "bugs": {
    "url": "https://github.com/opena2a-org/hackmyagent/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
