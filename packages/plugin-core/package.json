  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/opena2a-org/hackmyagent.git",
    "directory": "packages/plugin-core"
  },
  "engines": {
    "node": ">=18.0.0"
  }
