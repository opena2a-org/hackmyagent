    }
  },
  "devDependencies": {
    "@opena2a/aim-core": "^0.1.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.3",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "security",
    "plugin",
    "openclaw",
